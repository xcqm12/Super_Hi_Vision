*.unsigned

# ---------- 代码签名材料（私钥绝不入库）----------
*.pfx
*.p12
*.cer
signing/

# ffmpeg 完整静态版（约 420MB，CI 中自动下载）
ffmpeg/

# ---------- 日志 / 临时 ----------
*.log
*.tmp
_ffmpeg_case_tmp/
.DS_Store
Thumbs.db
