# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/

# ---------- PyInstaller 构建产物 ----------
build/
dist/
*.spec.bak

# ---------- 打包产物（体积大，由 CI 自动构建）----------
*.exe
*.msi
